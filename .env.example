# Required — from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_key_here

# Optional. Defaults to claude-opus-5.
# ANTHROPIC_MODEL=claude-sonnet-5

# Optional web-app settings.
# MAX_UPLOAD_MB=25
# LOG_LEVEL=INFO

# Optional. Set BOTH to put the whole site behind HTTP basic auth.
# Strongly recommended for a public Railway URL — every request spends API credits.
# APP_USERNAME=ten
# APP_PASSWORD=choose-a-long-random-string

# Optional. Emails every finished analysis (summary + PDF attachment).
# Leave RESEND_API_KEY unset to turn results emails off entirely.
# RESEND_API_KEY=re_your_key_here
# NOTIFY_EMAIL_TO=Info@tencapital.group
# NOTIFY_EMAIL_FROM=TEN Capital Network Analyzer <onepager@tencapital.group>
# NOTIFY_EMAIL_REPLY_TO=
